{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "A creative universe item representing a character, location, club, event, merch, post, chapter, or proposal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "area": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "tags": { "type": "array" },
        "links": { "type": "array" },
        "notes": { "type": "string" },
        "images": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "archived": { "type": "boolean" },
        "isProposal": { "type": "boolean" },
        "userId": { "type": "string" },
        "metadata": { "type": "object" }
      },
      "required": ["id", "title", "area", "type", "status", "priority", "archived", "isProposal", "userId"]
    },
    "Gorsel": {
      "title": "Gorsel",
      "description": "Gallery image kept outside item records; items reference it as gorsel:<id>. Written once, never updated",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "veri": { "type": "string" },
        "userId": { "type": "string" },
        "olusturma": { "type": "number" }
      },
      "required": ["id", "veri", "userId", "olusturma"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User profile settings like theme preference",
      "type": "object",
      "properties": {
        "theme": { "type": "string" }
      },
      "required": ["theme"]
    },
    "HaritaDuzeni": {
      "title": "HaritaDuzeni",
      "description": "Düzada map layout adjustments (boundaries, roads, places)",
      "type": "object",
      "properties": {
        "surum": { "type": "number" },
        "guncelleme": { "type": "number" },
        "hatlar": { "type": "object" },
        "yollar": { "type": "object" },
        "mekanlar": { "type": "object" }
      },
      "required": ["surum", "guncelleme", "hatlar", "yollar"]
    }
  },
  "firestore": {
    "/duzada/{docId}": {
      "schema": "HaritaDuzeni",
      "description": "World map layout modifications for Düzada"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": "Item",
      "description": "Creative universe items owned by a user"
    },
    "/users/{userId}/gorseller/{gorselId}": {
      "schema": "Gorsel",
      "description": "Gallery images stored outside item records (create/read/delete only)"
    },
    "/users/{userId}/settings/general": {
      "schema": "UserSettings",
      "description": "User preference settings"
    }
  }
}
