rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions & Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    // Kayıtlara yalnız Google'a bağlı sahibi erişir (22 Ekim). Önceden
    // girişsiz herkes her alana girebiliyordu.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-çÇğĞıİöÖşŞüÜâÂîÎûÛ]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for Item Entity
    function isValidItem(data) {
      return data.keys().hasAll(['id', 'title', 'area', 'type', 'status', 'priority', 'archived', 'isProposal', 'userId'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.area is string && data.area.size() <= 50
        && data.type is string && data.type.size() <= 50
        && data.status is string && data.status.size() <= 50
        && data.priority is string && data.priority.size() <= 50
        && data.archived is bool
        && data.isProposal is bool
        && data.userId is string && data.userId.size() <= 128;
    }

    // Validation Blueprint for UserSettings Entity
    function isValidUserSettings(data) {
      return data.keys().hasAll(['theme'])
        && data.theme is string && data.theme.size() <= 50;
    }

    // Harita düzeni (H1) — dünyaya ait, kullanıcıya değil. Tek belge:
    // duzada/haritaDuzeni. Google'a bağlı olmak şart (22 Ekim).
    match /duzada/{docId} {
      allow read: if isSignedIn() && docId == 'haritaDuzeni';
      allow create, update: if isSignedIn() && docId == 'haritaDuzeni'
        && incoming().keys().hasAll(['surum', 'guncelleme', 'hatlar', 'yollar'])
        && incoming().surum is number
        && incoming().guncelleme is number
        && incoming().hatlar is map
        && incoming().yollar is map;
      allow delete: if false;
    }

    // Eski ortak alan (kems_public): Durum → Eksikler'deki taşıma kartı
    // okuyabilsin diye yalnız okunur, Google'a bağlı olmak şart.
    match /users/kems_public/items/{itemId} {
      allow read: if isSignedIn();
    }

    // Match blocks for users collection
    match /users/{userId} {
      
      // Items subcollection
      match /items/{itemId} {
        allow read, delete: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(itemId)
          && incoming().id == itemId
          && incoming().userId == userId
          && isValidItem(incoming());

        allow update: if isOwner(userId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && isValidItem(incoming());
      }

      // Galeri görselleri (21 Ekim): görselin kendisi kayıttan ayrı durur,
      // kayıtta `gorsel:<id>` başvurusu kalır. Bir kez yazılır, değişmez.
      match /gorseller/{gorselId} {
        allow read, delete: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(gorselId)
          && incoming().keys().hasAll(['id', 'veri', 'userId', 'olusturma'])
          && incoming().keys().hasOnly(['id', 'veri', 'userId', 'olusturma'])
          && incoming().id == gorselId
          && incoming().userId == userId
          && incoming().veri is string
          && incoming().veri.size() <= 990000
          && incoming().olusturma is number;

        allow update: if false;
      }

      // Settings subcollection
      match /settings/{docId} {
        allow read: if isOwner(userId);
        
        allow write: if isOwner(userId)
          && isValidId(docId)
          && isValidUserSettings(incoming());
      }
    }
  }
}
